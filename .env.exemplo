# ============================================================
# VARIÁVEIS DO FUNIL DE QUALIFICAÇÃO — Profissão Lash Presencial
# ============================================================
# Copie para .env (que está no .gitignore) para rodar local, e
# configure as mesmas no Railway para produção.
# NUNCA commite o .env com valores reais.
# ============================================================

# ---------- BANCO ----------
# Em produção: a Railway injeta sozinha quando o Postgres é adicionado
# ao MESMO projeto do serviço (use a URL da rede interna).
# Em desenvolvimento: deixe VAZIO — o funil usa PGlite local, sem custo.
# DATABASE_URL=postgresql://postgres:SENHA@postgres.railway.internal:5432/railway

# ---------- PAINEL /crm ----------
# Sem CRM_SENHA o painel NÃO ABRE (falha fechada, de propósito).
# Mínimo de 12 caracteres. Gere uma com:  node funil-presencial/gerar-senha.js
CRM_USUARIO=nataly
CRM_SENHA=

# ---------- AVISO NO WHATSAPP ----------
# driver 'log'       -> escreve no console do servidor, NÃO envia nada. PADRÃO.
# driver 'evolution' -> envia de verdade pela Evolution API própria da Nataly.
NATALY_WA_DRIVER=log

# Destino do aviso. Aceita NÚMERO (só dígitos, com DDI) ou ID DE GRUPO.
# Hoje: o WhatsApp da Nataly. Quando o Eduardo criar o grupo, troque aqui
# pelo id do grupo (algo como 120363000000000000@g.us) — sem tocar em código.
NATALY_WA_DESTINO=5535997164668

# Enquanto vale 1, TODA mensagem começa com
# "Isso é um teste de uma automação, ignore".
# Coloque 0 só quando o fluxo estiver aprovado.
NATALY_WA_TESTE=1

# Instância própria da Nataly. NÃO use a Evolution da Haus (haus-r1):
# aquela serve o Roberta OS e não pode ser tocada.
# NATALY_WA_URL=https://evolution-nataly.up.railway.app
# NATALY_WA_KEY=
# NATALY_WA_INSTANCIA=nataly-avisos

# ---------- JÁ EXISTIAM (não são do funil) ----------
# HOTJAR_SITE_ID=
# FASE_PADRAO=
# META_CAPI_TOKEN=
# META_TEST_EVENT_CODE=
# KIWIFY_WEBHOOK_TOKEN=
